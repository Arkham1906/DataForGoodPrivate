# Plantilla del .env que lee docker-compose.yml. Cópiala a .env y cambia
# TODOS los valores; nunca subas el .env al repositorio.
#
# Escape de "$": en este archivo Compose interpreta "$" como variable, así
# que un "$" literal se escribe "$$" (p. ej. el hash bcrypt de
# ROOT_PASSWORD_HASH: $$2b$$10$$...). En .env.local (next dev) se usa "\$".

# --- App ---
# Solo el origen, sin subruta: la subruta (/dataforgood) la agrega BASE_PATH.
APP_ORIGIN=https://multimodal-ai-lab.cicese.mx
# Subruta de publicación; se incrusta en el build. Vacío = raíz del dominio.
BASE_PATH=/dataforgood
# Puerto del host donde queda la app (al que apunta el proxy). Por defecto 3000.
APP_PORT=3002

# --- PostgreSQL ---
# La contraseña va dentro de DATABASE_URL: usa solo letras, números y guiones.
# Ojo: Postgres guarda usuario y contraseña en el volumen la PRIMERA vez que
# arranca. Cambiarlos aquí después no cambia la base existente (ver README).
POSTGRES_USER=dataforgood
POSTGRES_PASSWORD=cambia-esta-clave-larga
POSTGRES_DB=dataforgood

# --- MinIO ---
# Root: solo lo usa minio-init para configurar. La app nunca lo recibe.
MINIO_ROOT_USER=cambia-este-root
MINIO_ROOT_PASSWORD=cambia-esta-clave-larga-del-root
# Usuario limitado al bucket que crea minio-init y que usa la app.
# Debe ser distinto del root; la clave, de al menos 8 caracteres.
MINIO_ACCESS_KEY=dataforgood-app
MINIO_SECRET_KEY=cambia-esta-clave-larga-de-la-app
MINIO_BUCKET=aportes
# Opcional: carpeta del host en vez del volumen con nombre (p. ej. Windows).
# MINIO_DATA=C:/minio/data

# --- SuperUsuario (/root) ---
ROOT_USER_ID=
ROOT_PASSWORD_HASH=

# --- Correo (códigos de verificación) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Incluye la subruta: debe coincidir con la registrada en Google Cloud Console.
GOOGLE_REDIRECT_URI=https://multimodal-ai-lab.cicese.mx/dataforgood/api/auth/google/callback

# Notificaciones push (Web Push). Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (Google, Apple, Mozilla): mailto: o https:
VAPID_SUBJECT=mailto:

# Tabla de líderes de la landing: "si" para verla. Déjala en "no" en producción mientras
# lib/gamificacion/clasificacion.ts devuelva datos de ejemplo.
MOSTRAR_TABLA_DE_LIDERES=no

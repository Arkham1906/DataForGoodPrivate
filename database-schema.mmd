erDiagram
    USUARIOS {
        int id PK
        varchar nombre
        varchar apellidos
        varchar email UK
        varchar password_hash
        varchar state
        varchar city
        varchar specialty
        jsonb intereses
        jsonb role
        int xp_total
        int level
        int streak_days
        boolean email_verificado
        int failed_login_attempts
        timestamptz locked_until
        varchar google_id UK
        timestamp created_at
        timestamp updated_at
    }
    USUARIO_PREFERENCIAS {
        int usuario_id PK,FK
        boolean avisos_campanas_nuevas
        boolean avisos_aportes
        boolean recordatorio_semanal
        boolean resumen_mensual
        boolean notificaciones_activas
        date ultimo_recordatorio
        date ultimo_resumen
    }
    CODIGOS_USUARIO {
        int usuario_id PK, FK
        varchar proposito PK
        varchar codigo_hash
        timestamptz vence_en
        int intentos
        timestamptz enviado_en
    }
    SESSIONS {
        int id PK
        varchar token_hash UK
        int usuario_id FK
        timestamp created_at
        timestamptz expires_at
    }

    ROOT_SESSIONS {
        int id PK
        varchar token_hash UK
        timestamp created_at
        timestamptz expires_at
    }

    CAMPANAS {
        int id PK
        int creator_id FK
        varchar creator_name
        int supervisor_id FK
        varchar name
        text description
        varchar tematica
        varchar tag
        varchar status
        varchar collection_mode
        jsonb checklist_opciones
        int goal_contributions
        int quota_per_user
        date start_date
        time start_time
        date end_date
        time end_time
        varchar location_city
        varchar location_state
        varchar organizer
        int xp_per_contribution
        timestamp created_at
        timestamp updated_at
    }

    CAMPANA_ESTADISTICAS {
        int campana_id PK,FK
        int current_contributions
        int approved_contributions
        int pending_contributions
        int rejected_contributions
        int participants
        int downloads_count
        smallint ultimo_hito_avisado
    }

    CAMPANA_ESPECIAL {
        int campana_id PK,FK
        date inicio
        date fin
        smallint multiplicador
        varchar insignia
    }

    CAMPANA_SUPERVISORES {
        int id PK
        int campana_id FK
        int supervisor_id FK
        varchar accion
        text motivo
        timestamptz created_at
    }

    CAMPANA_TIPOS {
        int campana_id PK,FK
        varchar tipo PK
        smallint orden
        int limite
        int enviados
        jsonb formatos
    }

    CAMPANA_REVISORES {
        int id PK
        int campana_id FK
        int usuario_id FK
        varchar estado
        timestamptz invitado_en
        timestamptz aceptado_en
    }

    CAMPANA_BANEADOS {
        int id PK
        int campana_id FK
        int usuario_id FK
        text motivo
        int baneado_por FK
        timestamptz created_at
    }

    NOTIFICACIONES {
        int id PK
        int usuario_id FK
        varchar tipo
        varchar titulo
        text mensaje
        int campana_id FK
        jsonb metadata
        timestamptz leida_en
        timestamptz created_at
    }

    CAMPANAS_GUARDADAS {
        int id PK
        int usuario_id FK
        int campana_id FK
        timestamp created_at
    }

    APORTES {
        int id PK
        int campaign_id FK
        int user_id FK
        varchar participant_name
        varchar participant_email
        text description
        varchar file_type
        int archivo_id FK
        jsonb caracteristicas
        varchar status
        text rejection_reason
        varchar first_pass_by
        timestamp submitted_at
        timestamp reviewed_at
        timestamp created_at
        timestamp updated_at
    }

    ARCHIVOS {
        int id PK
        varchar ruta
        varchar nombre_original
        varchar mime
        int tamano_bytes
        timestamptz borrado_en
        timestamptz creado_en
    }

    SANCIONES {
        int id PK
        int usuario_id FK
        varchar tipo
        text detalle
        int dias
        timestamptz aplicada_en
        varchar aplicada_por
        boolean activa
        timestamptz restaurada_en
    }

    USUARIOS ||--o{ SESSIONS : "inicia sesion"
    USUARIOS ||--o{ CODIGOS_USUARIO : "recibe codigos"
    USUARIOS ||--|| USUARIO_PREFERENCIAS : "tiene preferencias"
    USUARIOS ||--o{ CAMPANAS : "crea"
    USUARIOS o|--o{ CAMPANAS : "supervisa"
    USUARIOS ||--o{ CAMPANA_SUPERVISORES : "realiza acciones"
    CAMPANAS ||--o{ CAMPANA_SUPERVISORES : "tiene historial"
    USUARIOS ||--o{ CAMPANA_REVISORES : "es revisor"
    CAMPANAS ||--o{ CAMPANA_REVISORES : "asigna revisores"
    CAMPANAS ||--o{ CAMPANA_TIPOS : "pide tipos de dato"
    USUARIOS ||--o{ CAMPANA_BANEADOS : "es baneado"
    USUARIOS ||--o{ CAMPANA_BANEADOS : "banea"
    CAMPANAS ||--o{ CAMPANA_BANEADOS : "restringe usuarios"
    USUARIOS ||--o{ NOTIFICACIONES : "recibe"
    CAMPANAS o|--o{ NOTIFICACIONES : "origina"
    USUARIOS ||--o{ CAMPANAS_GUARDADAS : "guarda"
    CAMPANAS ||--o{ CAMPANAS_GUARDADAS : "es guardada"
    USUARIOS o|--o{ APORTES : "envia"
    CAMPANAS ||--o{ APORTES : "recibe"
    CAMPANAS ||--|| CAMPANA_ESTADISTICAS : "lleva contadores"
    CAMPANAS ||--o| CAMPANA_ESPECIAL : "puede ser especial"
    ARCHIVOS |o--o| APORTES : "guarda el archivo de"
    USUARIOS ||--o{ SANCIONES : "recibe sanciones"

